# Neon: copie a "connection string" do painel do Neon (com ?sslmode=require).
# Local: docker compose up -d  →  postgres://postgres:postgres@localhost:5433/life_hours
DATABASE_URL=

# Opcional: protege o app com uma senha (recomendado ao publicar na Vercel).
APP_PASSWORD=
# Opcional: segredo usado para assinar o cookie de sessão (qualquer texto longo e aleatório).
AUTH_SECRET=
# Opcional: senha (ex.: um PIN) pedida antes de criar, editar ou apagar qualquer dado. Vale por 10 min no navegador.
WRITE_PIN=

# Fuso horário usado para "hoje" (padrão America/Sao_Paulo).
NEXT_PUBLIC_TIME_ZONE=America/Sao_Paulo
